{
  "name": "winccoa-vscode-tests",
  "displayName": "WinCC OA Test Explorer",
  "description": "Test Explorer integration for WinCC OA unit tests in Visual Studio Code",
  "version": "1.0.15",
  "publisher": "RichardJanisch",
  "author": "Richard Janisch",
  "license": "MIT",
  "icon": "resources/wincc_oa_tests_icon_512.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/winccoa-tools-pack/vscode-winccoa-tests"
  },
  "bugs": {
    "url": "https://github.com/winccoa-tools-pack/vscode-winccoa-tests/issues"
  },
  "homepage": "https://github.com/winccoa-tools-pack/vscode-winccoa-tests#readme",
  "engines": {
    "vscode": "^1.108.0"
  },
  "categories": [
    "Testing",
    "Linters"
  ],
  "extensionDependencies": [
    "RichardJanisch.winccoa-script-actions",
    "RichardJanisch.winccoa-project-admin"
  ],
  "keywords": [
    "wincc-oa",
    "scada",
    "hmi",
    "siemens",
    "etm",
    "industrial",
    "automation",
    "testing",
    "test",
    "unittest",
    "test-explorer",
    "wincc-oa-test",
    "oa-test"
  ],
  "activationEvents": [
    "workspaceContains:**/*.ctl",
    "onLanguage:ctrl"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "winccoa-tests.refreshTests",
        "title": "Refresh Tests",
        "category": "WinCC OA Tests",
        "icon": "$(refresh)"
      },
      {
        "command": "winccoa-tests.runAllTests",
        "title": "Run All Tests",
        "category": "WinCC OA Tests",
        "icon": "$(run-all)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "winccoa-tests.refreshTests"
        },
        {
          "command": "winccoa-tests.runAllTests"
        }
      ]
    },
    "configuration": {
      "title": "WinCC OA Test Explorer",
      "properties": {
        "winccoaTests.testDiscoveryMode": {
          "type": "string",
          "enum": [
            "automatic",
            "workspace"
          ],
          "default": "automatic",
          "description": "How to discover WinCC OA test files",
          "enumDescriptions": [
            "Automatic: Use tests from currently selected project (WinCC OA Core extension)",
            "Workspace: Search in selected workspace folders for scripts/**/*.ctl"
          ]
        },
        "winccoaTests.workspaceFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Workspace folder names to search for tests (empty = all folders). Only used when testDiscoveryMode is 'workspace'."
        },
        "winccoaTests.logLevel": {
          "type": "string",
          "enum": [
            "ERROR",
            "WARN",
            "INFO",
            "DEBUG",
            "TRACE"
          ],
          "default": "INFO",
          "description": "Logging level for extension output",
          "enumDescriptions": [
            "Only critical errors",
            "Errors and warnings",
            "General information, errors and warnings (recommended)",
            "Detailed debugging information",
            "Very verbose trace information (for troubleshooting)"
          ]
        },
        "winccoaTests.testExecutionTimeout": {
          "type": "number",
          "default": 60000,
          "minimum": 5000,
          "description": "Maximum time (in milliseconds) to wait for test execution to complete and write results. Default: 60000ms (60 seconds)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && npm run copy-fixtures",
    "copy-fixtures": "copyfiles -u 1 \"src/test/fixtures/**/*\" out/",
    "build": "npm run compile",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint && npm run lint:md && npm run format:check",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "lint:md": "markdownlint \"**/*.md\" --ignore node_modules",
    "lint:md:fix": "markdownlint \"**/*.md\" --ignore node_modules --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vscode-test",
    "test:unit": "npm test",
    "test:integrationt": "vscode-test --suite integration",
    "ci:integration": "npm ci && npm run compile && npm run test:integrationt",
    "style-check": "npm run format:check && npm run lint"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.108.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "@winccoa-tools-pack/npm-winccoa-core": "^0.1.1",
    "copyfiles": "^2.4.1",
    "eslint": "^9.39.2",
    "glob": "^13.0.0",
    "markdownlint-cli": "^0.47.0",
    "mocha": "^11.3.0",
    "prettier": "^3.3.3",
    "source-map": "^0.8.0-beta.0",
    "ts-loader": "^9.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.0",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4"
  }
}
